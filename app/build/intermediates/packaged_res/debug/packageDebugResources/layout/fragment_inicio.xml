<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:padding="20dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Dashboard de Gastos"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/month_label"
            android:text="Resumen mensual de presupuesto"
            android:textColor="#718087"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Card Presupuesto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/teal"
            app:cardCornerRadius="22dp"
            app:strokeWidth="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:padding="22dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Disponible este mes"
                    android:textColor="#C8EFEB"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/available_amount"
                    android:text="$0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/budget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:progressTint="@color/coral"
                    android:layout_marginTop="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <TextView
                    android:id="@+id/budget_summary"
                    android:text="Gastado $0.00 de $0.00"
                    android:textColor="#E7FFFA"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Button to Dual Screen -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_explorer"
            android:text="Abrir Pantalla Dual (Espacio Multimedia)"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:icon="@drawable/ic_dual_screen"
            app:iconTint="#FFFFFF"
            android:padding="12dp"
            app:cornerRadius="12dp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Resumen Rápido por Categoría -->
        <TextView
            android:text="Resumen por Categoría"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/category_summary_list"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Gastos Recientes -->
        <TextView
            android:text="Gastos Recientes"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/recent_expenses"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
